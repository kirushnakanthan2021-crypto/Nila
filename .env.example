# Copy to .env locally; NEVER commit real API keys.
# Select one provider at a time: groq, openrouter, gemini, ollama, or custom.
NILA_LLM_PROVIDER=groq

# Provider-specific secrets (fill locally; leave blank in GitHub)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional Ollama local endpoint; no API key for typical local use
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional overrides
NILA_LLM_MODEL=
NILA_LLM_BASE_URL=
NILA_LLM_API_KEY=
NILA_LLM_TIMEOUT=45
NILA_LLM_MAX_TOKENS=512
NILA_LLM_AGENT=1

# Required by the private API, generate a long random value
NILA_API_TOKEN=
# Comma-separated exact frontend origins; never use *
NILA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
